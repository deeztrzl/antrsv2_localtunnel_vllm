# URL Koneksi Database PostgreSQL dengan pgvector
DATABASE_URL=

# Pakai model embedding lokal tanpa mengunduh ulang (hanya jika cache sudah ada)
HF_HUB_OFFLINE=1

# Opsional: folder penyimpanan data (default: ../data relatif terhadap folder backend)
DATA_DIR=

# ---------------------------------------------------------------
# Server VLM: baca dokumen / gambar (tahap ekstraksi)
# Kosongkan VLM_BASE_URL kalau mau memakai server LLM untuk keduanya
# ---------------------------------------------------------------
VLM_BASE_URL=
VLM_API_KEY=EMPTY
VLM_MODEL=
# Samakan dengan --max-model-len di server VLM
VLM_MAX_CONTEXT=8192

# ---------------------------------------------------------------
# Server LLM: interpretasi / analisis
# ---------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=EMPTY
LLM_MODEL=
# Samakan dengan --max-model-len di server LLM
LLM_MAX_CONTEXT=32768

# ---------------------------------------------------------------
# Tahap ekstraksi (jalan di server VLM)
# Prompt + output harus muat di VLM_MAX_CONTEXT
# ---------------------------------------------------------------
LLM_MAX_OUTPUT_EKSTRAKSI=4096
# Ukuran potongan teks per panggilan ekstraksi (karakter)
LLM_EKSTRAKSI_CHUNK_CHARS=2500

# ---------------------------------------------------------------
# Tahap analisis (jalan di server LLM)
# JANGAN isi output sama dengan LLM_MAX_CONTEXT: prompt + output harus muat
# ---------------------------------------------------------------
LLM_MAX_OUTPUT_ANALISIS=8192
# auto | penuh | berjenjang
# auto = analisis penuh kalau prompt muat, selain itu berjenjang
LLM_ANALISIS_MODE=auto
# Item per panggilan di mode berjenjang (naikkan kalau context LLM besar, mis. 10)
LLM_ANALISIS_BATCH_ITEM=4
